# Copy to .sandcastle/.env. Never commit .sandcastle/.env.
# GitHub token with Contents, Issues, Pull requests and Workflows, read/write.
GH_TOKEN=
# Claude Code (the loop agent). Use one of the two.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# This project: Sonnet to save tokens. The loop must not merge.
CLAUDE_MODEL=claude-sonnet-5-5
AUTO_MERGE=0
PROJECT=gosciniec-sylwester-gra
